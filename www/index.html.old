  <!-- Install guide -->
  <section id="install" class="download-section">
    <div class="container">
      <div class="install-notes">
        <h3 class="zh-only">安装与启动</h3>
        <h3 class="en-only">Install &amp; Run</h3>
        <details open>
          <summary>macOS</summary>
          <pre class="zh-only"># 安装 .pkg 后启动
webcool -s 0.0.0.0:8080 -D

# 数据默认目录
~/Library/Application Support/webcool/data</pre>
          <pre class="en-only"># After installing the .pkg
webcool -s 0.0.0.0:8080

# Default data directory
~/Library/Application Support/webcool/data</pre>
        </details>
        <details>
          <summary>Debian / Ubuntu</summary>
          <pre>sudo dpkg -i webcool_*.deb
webcool -s 0.0.0.0:8080 -D</pre>
        </details>
        <details>
          <summary>CentOS / RHEL</summary>
          <pre>sudo rpm -ivh webcool-*.rpm
webcool -s 0.0.0.0:8080 -D</pre>
        </details>
        <details>
          <summary>Windows</summary>
          <pre class="zh-only"># 解压后直接运行安装程序
# 默认目录：C:\Program Files\webcool
# 数据目录：C:\ProgramData\webcool\uploads

          <pre class="en-only"># Option 1: Run setup.exe installer
# Default: C:\Program Files\webcool
# Data: C:\ProgramData\webcool\uploads
</pre>
        </details>
        <details>
          <summary>Android</summary>
          <pre class="zh-only"># 安装 APK 后打开应用
# 登录页填写：http://&lt;服务器IP&gt;:8080
# 或使用「局域网扫描」自动发现</pre>
          <pre class="en-only"># After installing the APK, open the app
# Enter: http://&lt;server-ip&gt;:8080
# Or use LAN scan to auto-discover</pre>
        </details>
        <p class="download-unavailable zh-only" style="margin-top: 16px;">
          <!--安装包文件请放置于本站 <code>download/files/</code> 目录，并在 <code>releases.json</code> 中更新版本与文件名。-->
        </p>
        <p class="download-unavailable en-only" style="margin-top: 16px;">
          Place installer files in <code>download/files/</code> and update <code>releases.json</code> with version and filenames.
        </p>
      </div>
    </div>
  </section>

